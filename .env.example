# Plantilla de variables de entorno.
# Copia este fichero a `.env` (que está en .gitignore) y rellena los valores.
# Nunca subas los valores reales al repositorio.

# Notion
#NOTION_TOKEN=
#NOTION_CONTACT_DB_ID=

# Airtable
#AIRTABLE_BASE_ID=
#AIRTABLE_CONTACT_TABLE_ID=
#AIRTABLE_TOKEN=
#AIRTABLE_VIEW=

# Outlook
#OUTLOOK_SENDER_EMAIL=

# Vista previa antes del envío
#PREVIEW_EMAIL_BEFORE_SEND=
#PREVIEW_OPEN_IN_BROWSER=

# Ruta al python.exe de Windows con pywin32
#WINDOWS_PYTHON_PATH=

# Carpeta de Descargas usada por import_email_template.py
#DOWNLOADS_DIR=
